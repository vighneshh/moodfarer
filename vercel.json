{
  "version": 2,
  "builds": [
    { "src": "app.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/sw.js", "dest": "/app.py" },
    { "src": "/(.*)", "dest": "/app.py" }
  ],
  "crons": [
    { "path": "/api/cron/send-reminders", "schedule": "*/15 * * * *" }
  ]
}
